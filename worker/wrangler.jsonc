{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dawnlit-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://hwyii.github.io"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dawnlit",
      "database_id": "2dbcd459-80f2-4eda-b69a-83b8f3af907b"
    }
  ]
}
